SECRET_KEY=change-this-secret-key
# 게이트웨이가 신뢰할 앞단 프록시 IP(쉼표 구분, IPv4/CIDR). NPM, cloudflared CT110, CT131.
# 바꾼 뒤 gateway 컨테이너만 재시작하면 반영. 빈 값/형식 오류는 기동 실패.
GATEWAY_TRUSTED_PROXIES=172.30.1.101,172.30.1.110,172.30.1.31
COMPOSE_PROJECT_NAME=sandol_team
SERVICE_DOMAIN=sandori.kr
SANDOL_DATA_DIR=/home/ubuntu/data/sandol

KAKAO_TOKEN_ENCRYPTION_KEY=change-this-encryption-key

KC_DB_USERNAME=keycloak
KC_DB_PASSWORD=change-this-db-password

KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=change-this-admin-password

PG_EXPORTER_PASSWORD=change-this-db-password
# 마이그레이션 전 DB 스냅샷 저장 위치 (db-backup 서비스)
SANDOL_BACKUP_DIR=/home/ubuntu/data/sandol/backups
# 보관할 백업 디렉터리 개수. 초과분은 오래된 것부터 삭제된다.
BACKUP_KEEP=10
# keycloak_edge 네트워크 서브넷. Keycloak KC_PROXY_TRUSTED_ADDRESSES도 같은 값을 사용한다.
# 호스트/Docker 대역과 겹칠 때만 변경 (변경 시 keycloak·gateway 재생성 필요)
KEYCLOAK_EDGE_SUBNET=172.31.255.248/29
